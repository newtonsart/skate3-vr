#version 450
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0) uniform sampler2D gameImage;
layout(set=0,binding=1,rgba8) writeonly uniform image2D eyeImage;
layout(push_constant) uniform ColorParameters {
    uint decodeColor;
    float feather;
    float aspect;
    float padding;
} parameters;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    ivec2 size=imageSize(eyeImage);
    if(any(greaterThanEqual(p,size))) return;
    vec2 uv=(vec2(p)+0.5)/vec2(size);
    vec4 color=texture(gameImage,uv);
    // Guest output already contains display-encoded color. OpenXR UNORM
    // swapchains require linear color; decode exactly once before composition.
    if(parameters.decodeColor!=0) {
        vec3 low=color.rgb/12.92;
        vec3 high=pow((max(color.rgb,vec3(0))+0.055)/1.055,vec3(2.4));
        color.rgb=mix(high,low,lessThanEqual(color.rgb,vec3(0.04045)));
    }
    if(parameters.feather>0) {
        // Measure in panel-height units, independently of the eye texture's aspect.
        vec2 distanceToEdge=min(uv,1-uv)*vec2(parameters.aspect,1);
        vec2 fade=smoothstep(vec2(0),vec2(parameters.feather),distanceToEdge);
        float alpha=fade.x*fade.y;
        // OpenXR expects premultiplied linear color. Ignore the guest's internal alpha.
        color=vec4(color.rgb*alpha,alpha);
    }
    imageStore(eyeImage,p,color);
}
